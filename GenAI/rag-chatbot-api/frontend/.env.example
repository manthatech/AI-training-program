# Copy to .env.local and fill in only what you need.

# Must match API_KEY in backend/.env (leave empty if the backend has no API_KEY).
# Note: anything starting with VITE_ ends up in the browser bundle, so this is
# fine for local use but is not a real secret.
VITE_API_KEY=

# Where the built app should send requests. Leave empty when using `npm run dev`
# (the dev server forwards /api to the backend for you).
VITE_API_URL=
